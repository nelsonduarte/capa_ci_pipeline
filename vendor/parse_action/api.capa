// parse_action: the confined-parser boundary. The extern-component
// method takes NO capability parameter, so the sandboxed child is
// instantiated with an EMPTY linker: it can compute over the input text
// and return a result, but it cannot open a socket or read a file even if
// the parsing code is hostile. This is the structural answer to the
// supply-chain "malicious parser" class of attack.
extern component Parse from "parse.wasm"
    fun parse(text: String) -> String

pub fun run_parse(text: String) -> String
    return Parse.parse(text)
